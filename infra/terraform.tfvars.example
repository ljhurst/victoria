aws_region   = "us-east-1"
environment  = "prod"
project_name = "victoria"

mcp_lambda_package_path    = "../agent/dist/victoria-mcp.zip"
viewer_lambda_package_path = "../agent/dist/victoria-viewer.zip"

lasso_issuer_url = "https://lasso.example.com"

# Placeholder for the first apply — the real value is the MCP Lambda's own Function URL
resource_server_url = "https://victoria.example.com"

# Placeholder for the first apply — the real value is the viewer Lambda's own Function URL
viewer_base_url = "https://victoria-viewer.example.com"
